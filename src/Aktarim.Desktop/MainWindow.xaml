<Window x:Class="Aktarim.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Aktarım" Icon="Aktarim.ico" Height="800" Width="1280" MinWidth="936" MinHeight="640" Background="{DynamicResource Aktarim.Background}" Foreground="{DynamicResource Aktarim.Text}" FontFamily="Segoe UI" FontSize="14">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="{DynamicResource Aktarim.Sidebar}" BorderBrush="{DynamicResource Aktarim.Stroke}" BorderThickness="0,0,0,1">
   <DockPanel Margin="16,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="TR" AutomationProperties.AutomationId="LangTR" Click="Turkish" MinHeight="28" Padding="8,2"/><Button Content="EN" AutomationProperties.AutomationId="LangEN" Click="English" MinHeight="28" Padding="8,2" Margin="6,0,0,0"/></StackPanel>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="{DynamicResource Aktarim.Accent}" CornerRadius="5" Padding="5,1" Margin="0,0,8,0"><TextBlock Text="⇄" Foreground="{DynamicResource Aktarim.OnAccent}" FontWeight="Bold" FontSize="16"/></Border><TextBlock Text="Aktarım" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/><TextBlock Text="  STUDIO" FontSize="10" Foreground="{DynamicResource Aktarim.Muted}" VerticalAlignment="Center"/></StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition x:Name="SideColumn" Width="204"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="{DynamicResource Aktarim.Sidebar}" BorderBrush="{DynamicResource Aktarim.Stroke}" BorderThickness="0,0,1,0"><StackPanel Margin="13,20"><TextBlock x:Name="NavTitle" Foreground="{DynamicResource Aktarim.Muted}" FontSize="11" Margin="10,0,0,12"/><StackPanel x:Name="Navigation"/></StackPanel></Border>
   <Grid Grid.Column="1"><ScrollViewer x:Name="RegularScroll" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ContentPanel" Margin="24,24"/></ScrollViewer><Grid x:Name="UsbHost" Visibility="Collapsed"/></Grid>
  </Grid>
 </Grid>
</Window>
