<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Aktarim</AssemblyName>
    <ApplicationIcon>Aktarim.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Aktarim.ico" />
    <PackageReference Include="MediaDevices" Version="2.0.0" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aktarim.Core\Aktarim.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <EmbeddedResource Include="Web\**\*" LogicalName="Aktarim.Web.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
